// Ship the TrustLane JSON event log (logs/trustlane.jsonl) to Loki.
local.file_match "trustlane" {
  path_targets = [{"__path__" = "/logs/trustlane.jsonl", "job" = "trustlane"}]
}

loki.source.file "trustlane" {
  targets    = local.file_match.trustlane.targets
  forward_to = [loki.process.trustlane.receiver]
}

loki.process "trustlane" {
  stage.json {
    expressions = { kind = "kind", level = "level" }
  }
  stage.labels {
    values = { kind = "", level = "" }
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// Receive OpenTelemetry traces from the server (OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318)
// and forward them to Tempo.
otelcol.receiver.otlp "default" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
