# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# ---- Payments. TRUSTLANE_PAYMENTS: auto (default) | sandbox | razorpay | cashfree
# auto: Cashfree Reserve Pay if its keys are set, else Razorpay if its keys are set, else the built-in sandbox.
# TRUSTLANE_PAYMENTS=sandbox

# Razorpay TEST mode keys: Razorpay Dashboard -> switch to Test Mode -> Account & Settings -> API Keys.
# Live keys (rzp_live_...) are refused by the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: only needed if you register a webhook (needs a public URL, e.g. via a tunnel).
# Dashboard -> Webhooks -> URL https://<public-host>/api/payments/razorpay/webhook,
# events payment.captured and payment.failed, then paste the secret you chose here.
RAZORPAY_WEBHOOK_SECRET=

# UPI Reserve Pay through Cashfree SANDBOX: merchant.cashfree.com -> switch to Sandbox -> Developers -> API Keys.
# Webhooks (Developers -> Webhooks, Subscriptions): https://<public-host>/api/payments/cashfree/webhook
# They are signed with the client secret, so no extra webhook secret is needed.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Most a single Reserve Pay block may cover, in paise (NPCI cap is Rs 10,000 = 1000000).
# TRUSTLANE_RESERVE_PAY_MAX_PAISE=500000

# ---- Access
# Setup PIN: a break-glass admin sign-in for creating staff accounts (everyday sign-in is per person).
# Empty: a random PIN is printed at start and saved to data/staff_pin.txt.
# TRUSTLANE_STAFF_PIN=
# Shared key shelf stations must send (X-Station-Key / MQTT payload). Empty: not checked.
# Set it in a real store: it also protects each shelf's token key (/api/shelf/beacon).
# TRUSTLANE_STATION_KEY=
# Key the gate screen and gate agent send (X-Gate-Key). Set it in a real store: phones can then only exit
# by NFC tap or by showing their QR to the gate camera, not by posting to a gate directly.
# TRUSTLANE_GATE_KEY=

# ---- Package check model served to phones (default: models/shelf-classify.onnx, written by shelf_station.train)
# TRUSTLANE_PACKAGE_MODEL=

# ---- Shelf stations over MQTT (the monitoring stack runs a Mosquitto broker on 1883)
# TRUSTLANE_MQTT_URL=mqtt://127.0.0.1:1883

# ---- Alerts
# TRUSTLANE_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# TRUSTLANE_ALERT_WEBHOOK=https://example.com/hook
# On-call SMS for "bad" alerts (Twilio trial works; TWILIO_TO is comma-separated).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# TWILIO_TO=

# ---- Push notifications to the native app (Expo push). 0 turns them off.
# TRUSTLANE_PUSH=1

# ---- Tracing: send OpenTelemetry traces to Tempo (pip install -r monitoring/requirements-otel.txt)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# ---- Shopper accounts and invoices
# Invoice e-mails (SMTP over STARTTLS). Empty host: invoices stay in the app and at their signed link.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=receipts@example.com
# Public address of this server, used in links inside e-mails.
# TRUSTLANE_PUBLIC_URL=https://store1.trustlane.example
# Sign-in codes go by SMS through the Twilio settings above; without them the code is printed in the server log.

# ---- Store
# Which store this server runs (one server per store; see deploy/). Legal details and GSTIN: data/store.json.
# TRUSTLANE_STORE_ID=store-1
# Offers, coupons and loyalty rules (also editable in the ops console):
# TRUSTLANE_OFFERS=data/promotions.json

# ---- Per-device rate limits (raise only for load tests)
# TRUSTLANE_RATE_PER_SECOND=30
# TRUSTLANE_SESSIONS_PER_MINUTE=10

# ---- Store edge (python -m server.edge): its name in the ops console
# TRUSTLANE_EDGE_ID=edge-1
